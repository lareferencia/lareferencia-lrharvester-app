    <bean id="rcaapIndexingNetworkAction" class="org.lareferencia.backend.taskmanager.NetworkAction">
        <property name="name" value="RCAAP_INDEXING_ACTION"/>
        <property name="description" value="Indexar no RCAAP"></property>
        <property name="incremental" value="true"/>
        <property name="runOnSchedule" value="true"/>
        <property name="workers">
            <list>
                <value>rcaapIndexerWorker</value>
            </list>
        </property>
        <property name="properties">
            <list>
                <bean class="org.lareferencia.backend.taskmanager.NetworkProperty">
                    <property name="name" value="INDEX_RCAAP"/>
                    <property name="description" value="Indexar no RCAAP?"/>
                </bean>
                <bean class="org.lareferencia.backend.taskmanager.NetworkProperty">
                    <property name="name" value="INDEX_FULLTEXT"/>
                    <property name="description" value="Indexar texto completo?"/>
                </bean>
            </list>
        </property>
    </bean>

    <bean id="rcaapEntitiesIndexingNetworkAction" class="org.lareferencia.backend.taskmanager.NetworkAction">
        <property name="name" value="RCAAP_ENTITIES_INDEXING_ACTION"/>
        <property name="description" value="Indexar entidades (frontend Vufind)"></property>
        <property name="incremental" value="true"/>
        <property name="runOnSchedule" value="true"/>
        <property name="workers">
            <list>
                <value>rcaapServiceIndexerWorker</value>
                <value>rcaapPublicationIndexerWorker</value>
                <value>rcaapPersonIndexerWorker</value>
                <value>rcaapPersonDeduplicationWorker</value>
                <value>rcaapPersonSingletonWorker</value>

                <value>rcaapProjectIndexerWorker</value>
<!--
                <value>rcaapProjectFullDeduplicationWorker</value>
-->
                <value>rcaapProjectDeduplicationWorker</value>
                <value>rcaapProjectSingletonWorker</value>
<!--
                <value>rcaapOrganizationIndexerWorker</value>
-->
                <value>rcaapOrganizationNetworkIndexerWorker</value>
                <value>rcaapOrganizationFullDeduplicationWorker</value>
<!--
                <value>rcaapOrganizationDeduplicationWorker</value>
-->
                <value>rcaapOrganizationSingletonWorker</value>
                
            </list>
        </property>

        <property name="properties">
            <list>
                <bean class="org.lareferencia.backend.taskmanager.NetworkProperty">
                    <property name="name" value="INDEX_VUFIND"/>
                    <property name="description" value="Indexar entidades (frontend Vufind)?"/>
                </bean>
            </list>
        </property>
    </bean>



