    <bean id="rcaapOASISEntitiesIndexingNetworkAction" class="org.lareferencia.backend.taskmanager.NetworkAction">
        <property name="name" value="RCAAP_OASIS_ENTITIES_INDEXING_ACTION"/>
        <property name="description" value="Indexar Publicações do OASIS (frontend Vufind)"></property>
        <property name="incremental" value="true"/>
        <property name="runOnSchedule" value="true"/>
        <property name="workers">
            <list>
                <value>rcaapServiceIndexerWorker</value>
                <value>rcaapOrganizationNetworkIndexerWorker</value>
                <value>rcaapPublicationIndexerWorker</value>
            </list>
        </property>
        <property name="properties">
            <list>
                <bean class="org.lareferencia.backend.taskmanager.NetworkProperty">
                    <property name="name" value="INDEX_OASIS_PUBLICATION"/>
                    <property name="description" value="Indexar apenas Publicações?"/>
                </bean>
            </list>
        </property>
    </bean>

    <bean id="rcaapDeleteAction" class="org.lareferencia.backend.taskmanager.NetworkAction">
        <property name="name" value="RCAAP_DELETE_ACTION"/>
        <property name="description" value="Apagar do indice RCAAP"></property>
        <property name="workers">
            <list>
                <value>rcaapDeleteWorker</value>
            </list>
        </property>
    </bean>

	<!-- WORKERS -->

	<!-- publications -->
    <bean id="rcaapPublicationIndexerWorker" class="org.lareferencia.backend.workers.indexer.IndexerWorker" scope="prototype">
        <constructor-arg>
            <value>${publication.solr.url}</value>
        </constructor-arg>

        <property name="serialLaneId" value="10"/>
        <property name="targetSchemaName" value="vufind-publication"/>

        <property name="solrNetworkIDField" value="network_acronym_str"/>
        <property name="solrRecordIDField" value="id"/>

        <property name="pageSize" value="1000"/>

        <property name="executeDeletion" value="false"/>
        <property name="executeIndexing" value="true"/>

        <property name="indexDeletedRecords" value="false"/>
        <property name="indexNetworkAttributes" value="true" />
    </bean>

    <bean id="rcaapPublicationNetworkDeleteWorker" class="org.lareferencia.backend.workers.indexer.IndexerWorker" scope="prototype">
        <constructor-arg>
            <value>${publication.solr.url}</value>
        </constructor-arg>

        <property name="serialLaneId" value="10"/>

        <property name="solrNetworkIDField" value="network_acronym_str"/>
        <property name="solrRecordIDField" value="id"/>

        <property name="executeDeletion" value="true"/>
    </bean>

