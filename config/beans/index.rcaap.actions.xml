	<!-- services -->
    <bean id="rcaapServiceIndexerWorker" class="org.lareferencia.contrib.rcaap.backend.workers.NetworkIndexWorker" scope="prototype">
        <constructor-arg>
            <value>${service.solr.url}</value>
